    (numB n).coeff (center n-2)*(numB n).coeff (center n) ≤
      ((numB n).coeff (center n-1))^2 ∧
    (numB n).coeff (center n)*(numB n).coeff (center n+2) ≤
      ((numB n).coeff (center n+1))^2

